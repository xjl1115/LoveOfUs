# 复制为 .env 后按需修改：cp .env.example .env
MYSQL_ROOT_PASSWORD=1115
REDIS_PASSWORD=1115
HTTP_PORT=80

# 文件存储：oss（必填，应用依赖 OSS 上传，local 模式无法启动）
FILE_STORAGE=oss
FILE_LOCAL_URL_PREFIX=http://localhost/uploads

# 阿里云 OSS（AK/SK 必填；bucket 默认 allenxjl，如用其他桶请修改）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=allenxjl
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# 邮件（可选）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# AI 通义千问（AI_ENABLED=true 时必填）
AI_ENABLED=true
DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_MODEL=

# VIP 顾问开通密钥（必填）
# 顾问收款后开通订单的凭据：请求头 X-Vip-Admin-Token 必须与之一致；未配置时开通接口返回 403。
# 生成：openssl rand -hex 32
VIP_ADMIN_TOKEN=你的随机密钥

# VIP 顾问开通接口对外地址（末尾不带 /）：用于生成顾问通知邮件里的开通命令
# 生产环境改成公网域名，例如 https://loveofus.com
VIP_PUBLIC_BASE_URL=http://localhost:8080
