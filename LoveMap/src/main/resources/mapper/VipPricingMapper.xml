<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lovemap.mapper.VipPricingMapper">

    <resultMap id="BaseResultMap" type="com.example.lovemap.model.entity.VipPricing">
        <id column="id" property="id"/>
        <result column="product_code" property="productCode"/>
        <result column="product_name" property="productName"/>
        <result column="product_type" property="productType"/>
        <result column="vip_level" property="vipLevel"/>
        <result column="quota_type" property="quotaType"/>
        <result column="price_yuan" property="priceYuan"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, product_code, product_name, product_type, vip_level, quota_type,
        price_yuan, description, sort_order, updated_at
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM vip_pricing
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM vip_pricing
        WHERE product_code = #{productCode}
        LIMIT 1
    </select>

    <update id="updatePrice">
        UPDATE vip_pricing
        SET price_yuan = #{priceYuan}
        WHERE id = #{id}
    </update>

</mapper>
